{"type":"tool_use","timestamp":1785872416155,"sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","part":{"type":"tool","tool":"read","callID":"read_1","state":{"status":"completed","input":{"filePath":"C:\\WORK\\mt-asphalt-wt-backend\\app\\api\\leads.js"},"output":"<path>C:\\WORK\\mt-asphalt-wt-backend\\app\\api\\leads.js</path>\n<type>file</type>\n<content>\n1: // MT Asphalt — serverless lead inbox (Vercel Function + Vercel Blob).\n2: //\n3: //   POST /api/leads  → store an estimate request (one blob per lead: no write races)\n4: //   GET  /api/leads  → newest-first list; the dashboard merges these on load\n5: //\n6: // Email notification: set RESEND_API_KEY (+ optionally NOTIFY_EMAIL / NOTIFY_FROM)\n7: // in Vercel env vars and Michael gets an email for every new request. Without the\n8: // key it silently skips — safe to deploy before Resend is set up.\n9: import { put, list } from \"@vercel/blob\";\n10: \n11: const MAX = (s, n) => String(s ?? \"\").slice(0, n);\n12: \n13: export default async function handler(req, res) {\n14:   res.setHeader(\"Cache-Control\", \"no-store\");\n15: \n16:   try {\n17:     if (req.method === \"POST\") {\n18:       const b = typeof req.body === \"object\" && req.body ? req.body : {};\n19:       if (!MAX(b.name, 120).trim() || !MAX(b.phone, 40).trim()) {\n20:         return res.status(400).json({ error: \"name and phone are required\" });\n21:       }\n22: \n23:       // Server-authoritative shape — never trust client fields blindly.\n24:       const lead = {\n25:         id: `l-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`,\n26:         name: MAX(b.name, 120).trim(),\n27:         phone: MAX(b.phone, 40).trim(),\n28:         email: MAX(b.email, 160).trim(),\n29:         address: MAX(b.address, 200).trim(),\n30:         city: MAX(b.city, 80).trim(),\n31:         serviceInterest: MAX(b.serviceInterest, 160).trim() || \"General inquiry\",\n32:         message: MAX(b.message, 2000).trim(),\n33:         status: \"new\",\n34:         source: \"website\",\n35:         createdAt: new Date().toISOString(),\n36:       };\n37: \n38:       await put(`leads/${lead.id}.json`, JSON.stringify(lead), {\n39:         access: \"public\",\n40:         addRandomSuffix: false,\n41:         contentType: \"application/json\",\n42:       });\n43: \n44:       await notifyMichael(lead); // no-op until RESEND_API_KEY is configured\n45:       return res.status(201).json({ ok: true, id: lead.id });\n46:     }\n47: \n48:     if (req.method === \"GET\") {\n49:       const { blobs } = await list({ prefix: \"leads/\", limit: 200 });\n50:       const leads = await Promise.all(\n51:         blobs.map(async (blob) => {\n52:           try {\n53:             const r = await fetch(`${blob.url}?t=${Date.now()}`); // bust edge cache\n54:             return await r.json();\n55:           } catch {\n56:             return null;\n57:           }\n58:         })\n59:       );\n60:       const clean = leads\n61:         .filter((l) => l && l.id)\n62:         .sort((a, z) => String(z.createdAt).localeCompare(String(a.createdAt)));\n63:       return res.status(200).json(clean);\n64:     }\n65: \n66:     res.setHeader(\"Allow\", \"GET, POST\");\n67:     return res.status(405).json({ error: \"method not allowed\" });\n68:   } catch (err) {\n69:     // Most common cause: Blob store not connected yet (missing BLOB_READ_WRITE_TOKEN)\n70:     return res.status(500).json({ error: \"lead storage unavailable\", detail: String(err?.message ?? err) });\n71:   }\n72: }\n73: \n74: async function notifyMichael(lead) {\n75:   const key = process.env.RESEND_API_KEY;\n76:   const to = process.env.NOTIFY_EMAIL;\n77:   if (!key || !to) return;\n78:   try {\n79:     await fetch(\"https://api.resend.com/emails\", {\n80:       method: \"POST\",\n81:       headers: { Authorization: `Bearer ${key}`, \"Content-Type\": \"application/json\" },\n82:       body: JSON.stringify({\n83:         from: process.env.NOTIFY_FROM || \"MT Asphalt Website <onboarding@resend.dev>\",\n84:         to: [to],\n85:         subject: `New estimate request — ${lead.name}${lead.city ? ` (${lead.city})` : \"\"}`,\n86:         text: [\n87:           `New free-estimate request from the MT Asphalt website:`,\n88:           ``,\n89:           `Name:     ${lead.name}`,\n90:           `Phone:    ${lead.phone}`,\n91:           `Email:    ${lead.email || \"—\"}`,\n92:           `City:     ${lead.city || \"—\"}`,\n93:           `Service:  ${lead.serviceInterest}`,\n94:           ``,\n95:           `Message:`,\n96:           lead.message || \"—\",\n97:           ``,\n98:           `Open the dashboard → /dashboard/leads`,\n99:         ].join(\"\\n\"),\n100:       }),\n101:     });\n102:   } catch {\n103:     /* email failure must never lose the lead */\n104:   }\n105: }\n\n(End of file - total 105 lines)\n</content>","metadata":{"preview":"// MT Asphalt — serverless lead inbox (Vercel Function + Vercel Blob).\n//\n//   POST /api/leads  → store an estimate request (one blob per lead: no write races)\n//   GET  /api/leads  → newest-first list; the dashboard merges these on load\n//\n// Email notification: set RESEND_API_KEY (+ optionally NOTIFY_EMAIL / NOTIFY_FROM)\n// in Vercel env vars and Michael gets an email for every new request. Without the\n// key it silently skips — safe to deploy before Resend is set up.\nimport { put, list } from \"@vercel/blob\";\n\nconst MAX = (s, n) => String(s ?? \"\").slice(0, n);\n\nexport default async function handler(req, res) {\n  res.setHeader(\"Cache-Control\", \"no-store\");\n\n  try {\n    if (req.method === \"POST\") {\n      const b = typeof req.body === \"object\" && req.body ? req.body : {};\n      if (!MAX(b.name, 120).trim() || !MAX(b.phone, 40).trim()) {\n        return res.status(400).json({ error: \"name and phone are required\" });","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\WORK\\mt-asphalt-wt-backend\\app\\api\\leads.js","text":"// MT Asphalt — serverless lead inbox (Vercel Function + Vercel Blob).\n//\n//   POST /api/leads  → store an estimate request (one blob per lead: no write races)\n//   GET  /api/leads  → newest-first list; the dashboard merges these on load\n//\n// Email notification: set RESEND_API_KEY (+ optionally NOTIFY_EMAIL / NOTIFY_FROM)\n// in Vercel env vars and Michael gets an email for every new request. Without the\n// key it silently skips — safe to deploy before Resend is set up.\nimport { put, list } from \"@vercel/blob\";\n\nconst MAX = (s, n) => String(s ?? \"\").slice(0, n);\n\nexport default async function handler(req, res) {\n  res.setHeader(\"Cache-Control\", \"no-store\");\n\n  try {\n    if (req.method === \"POST\") {\n      const b = typeof req.body === \"object\" && req.body ? req.body : {};\n      if (!MAX(b.name, 120).trim() || !MAX(b.phone, 40).trim()) {\n        return res.status(400).json({ error: \"name and phone are required\" });\n      }\n\n      // Server-authoritative shape — never trust client fields blindly.\n      const lead = {\n        id: `l-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`,\n        name: MAX(b.name, 120).trim(),\n        phone: MAX(b.phone, 40).trim(),\n        email: MAX(b.email, 160).trim(),\n        address: MAX(b.address, 200).trim(),\n        city: MAX(b.city, 80).trim(),\n        serviceInterest: MAX(b.serviceInterest, 160).trim() || \"General inquiry\",\n        message: MAX(b.message, 2000).trim(),\n        status: \"new\",\n        source: \"website\",\n        createdAt: new Date().toISOString(),\n      };\n\n      await put(`leads/${lead.id}.json`, JSON.stringify(lead), {\n        access: \"public\",\n        addRandomSuffix: false,\n        contentType: \"application/json\",\n      });\n\n      await notifyMichael(lead); // no-op until RESEND_API_KEY is configured\n      return res.status(201).json({ ok: true, id: lead.id });\n    }\n\n    if (req.method === \"GET\") {\n      const { blobs } = await list({ prefix: \"leads/\", limit: 200 });\n      const leads = await Promise.all(\n        blobs.map(async (blob) => {\n          try {\n            const r = await fetch(`${blob.url}?t=${Date.now()}`); // bust edge cache\n            return await r.json();\n          } catch {\n            return null;\n          }\n        })\n      );\n      const clean = leads\n        .filter((l) => l && l.id)\n        .sort((a, z) => String(z.createdAt).localeCompare(String(a.createdAt)));\n      return res.status(200).json(clean);\n    }\n\n    res.setHeader(\"Allow\", \"GET, POST\");\n    return res.status(405).json({ error: \"method not allowed\" });\n  } catch (err) {\n    // Most common cause: Blob store not connected yet (missing BLOB_READ_WRITE_TOKEN)\n    return res.status(500).json({ error: \"lead storage unavailable\", detail: String(err?.message ?? err) });\n  }\n}\n\nasync function notifyMichael(lead) {\n  const key = process.env.RESEND_API_KEY;\n  const to = process.env.NOTIFY_EMAIL;\n  if (!key || !to) return;\n  try {\n    await fetch(\"https://api.resend.com/emails\", {\n      method: \"POST\",\n      headers: { Authorization: `Bearer ${key}`, \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        from: process.env.NOTIFY_FROM || \"MT Asphalt Website <onboarding@resend.dev>\",\n        to: [to],\n        subject: `New estimate request — ${lead.name}${lead.city ? ` (${lead.city})` : \"\"}`,\n        text: [\n          `New free-estimate request from the MT Asphalt website:`,\n          ``,\n          `Name:     ${lead.name}`,\n          `Phone:    ${lead.phone}`,\n          `Email:    ${lead.email || \"—\"}`,\n          `City:     ${lead.city || \"—\"}`,\n          `Service:  ${lead.serviceInterest}`,\n          ``,\n          `Message:`,\n          lead.message || \"—\",\n          ``,\n          `Open the dashboard → /dashboard/leads`,\n        ].join(\"\\n\"),\n      }),\n    });\n  } catch {\n    /* email failure must never lose the lead */\n  }\n}","lineStart":1,"lineEnd":105,"totalLines":105,"truncated":false}},"title":"app\\api\\leads.js","time":{"start":1785872416127,"end":1785872416151}},"id":"prt_fce4a79b9001Jz4CsWddyYv9VN","sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","messageID":"msg_fce4a4b1f001D0nD851Ro9FLTz"}}
{"type":"tool_use","timestamp":1785872417115,"sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","part":{"type":"tool","tool":"read","callID":"read_2","state":{"status":"completed","input":{"filePath":"C:\\WORK\\mt-asphalt-wt-backend\\app\\src\\lib\\store.tsx"},"output":"<path>C:\\WORK\\mt-asphalt-wt-backend\\app\\src\\lib\\store.tsx</path>\n<type>file</type>\n<content>\n1: import React, { createContext, useContext, useEffect, useMemo, useRef, useState } from \"react\";\n2: import type {\n3:   Database,\n4:   Settings,\n5:   Lead,\n6:   Job,\n7:   Invoice,\n8:   Customer,\n9:   Service,\n10:   Testimonial,\n11:   Contract,\n12:   Material,\n13:   Equipment,\n14: } from \"./types\";\n15: import { seed } from \"./seed\";\n16: \n17: /* ============================================================\n18:    Store — the app's data tier.\n19:    Persists the whole database to localStorage and exposes a\n20:    small typed API (read + mutate). Shaped like a repository so\n21:    it can be swapped for the included Express/JSON server later\n22:    without touching component code.\n23:    ============================================================ */\n24: \n25: const KEY = \"mt-asphalt-db-v1\";\n26: const AUTH_KEY = \"mt-asphalt-auth-v1\";\n27: \n28: // Optional backend tier. When VITE_API_URL is set (e.g. http://localhost:8787),\n29: // the store hydrates from and syncs to the Node REST server; otherwise it runs\n30: // entirely on localStorage. Component code is identical either way.\n31: const API = (import.meta.env.VITE_API_URL as string | undefined)?.replace(/\\/$/, \"\");\n32: \n33: function load(): Database {\n34:   try {\n35:     const raw = localStorage.getItem(KEY);\n36:     if (raw) return JSON.parse(raw) as Database;\n37:   } catch {\n38:     /* ignore */\n39:   }\n40:   return structuredClone(seed);\n41: }\n42: \n43: interface StoreApi {\n44:   db: Database;\n45:   // settings\n46:   updateSettings: (patch: Partial<Settings>) => void;\n47:   // generic collection mutators\n48:   addLead: (lead: Lead) => void;\n49:   updateLead: (id: string, patch: Partial<Lead>) => void;\n50:   removeLead: (id: string) => void;\n51:   updateJob: (id: string, patch: Partial<Job>) => void;\n52:   addJob: (job: Job) => void;\n53:   addInvoice: (inv: Invoice) => void;\n54:   updateInvoice: (id: string, patch: Partial<Invoice>) => void;\n55:   addCustomer: (c: Customer) => void;\n56:   updateCustomer: (id: string, patch: Partial<Customer>) => void;\n57:   addContract: (c: Contract) => void;\n58:   updateContract: (id: string, patch: Partial<Contract>) => void;\n59:   addService: (s: Service) => void;\n60:   updateService: (id: string, patch: Partial<Service>) => void;\n61:   removeService: (id: string) => void;\n62:   addTestimonial: (t: Testimonial) => void;\n63:   updateTestimonial: (id: string, patch: Partial<Testimonial>) => void;\n64:   removeTestimonial: (id: string) => void;\n65:   updateMaterial: (id: string, patch: Partial<Material>) => void;\n66:   updateEquipment: (id: string, patch: Partial<Equipment>) => void;\n67:   resetAll: () => void;\n68: }\n69: \n70: const StoreCtx = createContext<StoreApi | null>(null);\n71: \n72: export function StoreProvider({ children }: { children: React.ReactNode }) {\n73:   const [db, setDb] = useState<Database>(load);\n74:   const hydrated = useRef(false);\n75: \n76:   // Hydrate from the API server on first mount, if configured.\n77:   useEffect(() => {\n78:     if (!API) {\n79:       hydrated.current = true;\n80:       return;\n81:     }\n82:     let cancelled = false;\n83:     (async () => {\n84:       try {\n85:         const res = await fetch(`${API}/api/db`);\n86:         const remote = await res.json();\n87:         if (!cancelled && remote && remote.settings) {\n88:           setDb(remote as Database);\n89:         } else if (!cancelled) {\n90:           // Server is empty — seed it with our current data.\n91:           fetch(`${API}/api/db`, {\n92:             method: \"PUT\",\n93:             headers: { \"Content-Type\": \"application/json\" },\n94:             body: JSON.stringify(db),\n95:           }).catch(() => {});\n96:         }\n97:       } catch {\n98:         /* offline — fall back to localStorage copy already in state */\n99:       } finally {\n100:         hydrated.current = true;\n101:       }\n102:     })();\n103:     return () => {\n104:       cancelled = true;\n105:     };\n106:     // eslint-disable-next-line react-hooks/exhaustive-deps\n107:   }, []);\n108: \n109:   // Pull the serverless lead inbox (/api/leads on Vercel) and merge any leads\n110:   // this browser hasn't seen — website estimate requests reach the dashboard\n111:   // from any device this way.\n112:   useEffect(() => {\n113:     (async () => {\n114:       try {\n115:         const res = await fetch(\"/api/leads\", { headers: { accept: \"application/json\" } });\n116:         if (!res.ok || !res.headers.get(\"content-type\")?.includes(\"json\")) return;\n117:         const remote = (await res.json()) as Partial<Lead>[];\n118:         if (!Array.isArray(remote) || remote.length === 0) return;\n119:         setDb((d) => {\n120:           const known = new Set(d.leads.map((l) => l.id));\n121:           const fresh: Lead[] = remote\n122:             .filter((l) => l && typeof l.id === \"string\" && !known.has(l.id))\n123:             .map((l) => ({\n124:               id: l.id!,\n125:               name: l.name ?? \"Unknown\",\n126:               phone: l.phone ?? \"\",\n127:               email: l.email ?? \"\",\n128:               address: l.address ?? \"\",\n129:               city: l.city ?? \"\",\n130:               serviceInterest: l.serviceInterest ?? \"General inquiry\",\n131:               message: l.message ?? \"\",\n132:               status: l.status ?? \"new\",\n133:               source: l.source ?? \"website\",\n134:               createdAt: l.createdAt ?? new Date().toISOString(),\n135:               estSqft: l.estSqft,\n136:               value: l.value,\n137:             }));\n138:           if (fresh.length === 0) return d;\n139:           return { ...d, leads: [...fresh, ...d.leads] };\n140:         });\n141:       } catch {\n142:         /* local dev or offline — dashboard still works from local data */\n143:       }\n144:     })();\n145:   }, []);\n146: \n147:   // Persist: always to localStorage; debounced to the API when configured.\n148:   useEffect(() => {\n149:     try {\n150:       localStorage.setItem(KEY, JSON.stringify(db));\n151:     } catch {\n152:       /* quota — ignore */\n153:     }\n154:     if (!API || !hydrated.current) return;\n155:     const t = setTimeout(() => {\n156:       fetch(`${API}/api/db`, {\n157:         method: \"PUT\",\n158:         headers: { \"Content-Type\": \"application/json\" },\n159:         body: JSON.stringify(db),\n160:       }).catch(() => {});\n161:     }, 500);\n162:     return () => clearTimeout(t);\n163:   }, [db]);\n164: \n165:   const api = useMemo<StoreApi>(() => {\n166:     const patchIn = <T extends { id: string }>(arr: T[], id: string, patch: Partial<T>): T[] =>\n167:       arr.map((x) => (x.id === id ? { ...x, ...patch } : x));\n168: \n169:     return {\n170:       db,\n171:       updateSettings: (patch) => setDb((d) => ({ ...d, settings: { ...d.settings, ...patch } })),\n172: \n173:       addLead: (lead) => setDb((d) => ({ ...d, leads: [lead, ...d.leads] })),\n174:       updateLead: (id, patch) => setDb((d) => ({ ...d, leads: patchIn(d.leads, id, patch) })),\n175:       removeLead: (id) => setDb((d) => ({ ...d, leads: d.leads.filter((l) => l.id !== id) })),\n176: \n177:       updateJob: (id, patch) => setDb((d) => ({ ...d, jobs: patchIn(d.jobs, id, patch) })),\n178:       addJob: (job) => setDb((d) => ({ ...d, jobs: [job, ...d.jobs] })),\n179: \n180:       addInvoice: (inv) => setDb((d) => ({ ...d, invoices: [inv, ...d.invoices] })),\n181:       updateInvoice: (id, patch) =>\n182:         setDb((d) => ({ ...d, invoices: patchIn(d.invoices, id, patch) })),\n183: \n184:       addCustomer: (c) => setDb((d) => ({ ...d, customers: [c, ...d.customers] })),\n185:       updateCustomer: (id, patch) =>\n186:         setDb((d) => ({ ...d, customers: patchIn(d.customers, id, patch) })),\n187: \n188:       addContract: (c) => setDb((d) => ({ ...d, contracts: [c, ...d.contracts] })),\n189:       updateContract: (id, patch) =>\n190:         setDb((d) => ({ ...d, contracts: patchIn(d.contracts, id, patch) })),\n191: \n192:       addService: (s) => setDb((d) => ({ ...d, services: [...d.services, s] })),\n193:       updateService: (id, patch) =>\n194:         setDb((d) => ({ ...d, services: patchIn(d.services, id, patch) })),\n195:       removeService: (id) =>\n196:         setDb((d) => ({ ...d, services: d.services.filter((s) => s.id !== id) })),\n197: \n198:       addTestimonial: (t) => setDb((d) => ({ ...d, testimonials: [...d.testimonials, t] })),\n199:       updateTestimonial: (id, patch) =>\n200:         setDb((d) => ({ ...d, testimonials: patchIn(d.testimonials, id, patch) })),\n201:       removeTestimonial: (id) =>\n202:         setDb((d) => ({ ...d, testimonials: d.testimonials.filter((t) => t.id !== id) })),\n203: \n204:       updateMaterial: (id, patch) =>\n205:         setDb((d) => ({ ...d, materials: patchIn(d.materials, id, patch) })),\n206:       updateEquipment: (id, patch) =>\n207:         setDb((d) => ({ ...d, equipment: patchIn(d.equipment, id, patch) })),\n208: \n209:       resetAll: () => setDb(structuredClone(seed)),\n210:     };\n211:   }, [db]);\n212: \n213:   return <StoreCtx.Provider value={api}>{children}</StoreCtx.Provider>;\n214: }\n215: \n216: export function useStore() {\n217:   const ctx = useContext(StoreCtx);\n218:   if (!ctx) throw new Error(\"useStore must be used within StoreProvider\");\n219:   return ctx;\n220: }\n221: \n222: /* ---- lightweight auth (local, single-owner) ---- */\n223: export function useAuth() {\n224:   const [authed, setAuthed] = useState<boolean>(() => {\n225:     try {\n226:       return sessionStorage.getItem(AUTH_KEY) === \"1\";\n227:     } catch {\n228:       return false;\n229:     }\n230:   });\n231:   const login = (password: string) => {\n232:     // Demo gate — any non-empty password unlocks Michael's console.\n233:     if (password.trim().length > 0) {\n234:       sessionStorage.setItem(AUTH_KEY, \"1\");\n235:       setAuthed(true);\n236:       return true;\n237:     }\n238:     return false;\n239:   };\n240:   const logout = () => {\n241:     sessionStorage.removeItem(AUTH_KEY);\n242:     setAuthed(false);\n243:   };\n244:   return { authed, login, logout };\n245: }\n\n(End of file - total 245 lines)\n</content>","metadata":{"preview":"import React, { createContext, useContext, useEffect, useMemo, useRef, useState } from \"react\";\nimport type {\n  Database,\n  Settings,\n  Lead,\n  Job,\n  Invoice,\n  Customer,\n  Service,\n  Testimonial,\n  Contract,\n  Material,\n  Equipment,\n} from \"./types\";\nimport { seed } from \"./seed\";\n\n/* ============================================================\n   Store — the app's data tier.\n   Persists the whole database to localStorage and exposes a\n   small typed API (read + mutate). Shaped like a repository so","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\WORK\\mt-asphalt-wt-backend\\app\\src\\lib\\store.tsx","text":"import React, { createContext, useContext, useEffect, useMemo, useRef, useState } from \"react\";\nimport type {\n  Database,\n  Settings,\n  Lead,\n  Job,\n  Invoice,\n  Customer,\n  Service,\n  Testimonial,\n  Contract,\n  Material,\n  Equipment,\n} from \"./types\";\nimport { seed } from \"./seed\";\n\n/* ============================================================\n   Store — the app's data tier.\n   Persists the whole database to localStorage and exposes a\n   small typed API (read + mutate). Shaped like a repository so\n   it can be swapped for the included Express/JSON server later\n   without touching component code.\n   ============================================================ */\n\nconst KEY = \"mt-asphalt-db-v1\";\nconst AUTH_KEY = \"mt-asphalt-auth-v1\";\n\n// Optional backend tier. When VITE_API_URL is set (e.g. http://localhost:8787),\n// the store hydrates from and syncs to the Node REST server; otherwise it runs\n// entirely on localStorage. Component code is identical either way.\nconst API = (import.meta.env.VITE_API_URL as string | undefined)?.replace(/\\/$/, \"\");\n\nfunction load(): Database {\n  try {\n    const raw = localStorage.getItem(KEY);\n    if (raw) return JSON.parse(raw) as Database;\n  } catch {\n    /* ignore */\n  }\n  return structuredClone(seed);\n}\n\ninterface StoreApi {\n  db: Database;\n  // settings\n  updateSettings: (patch: Partial<Settings>) => void;\n  // generic collection mutators\n  addLead: (lead: Lead) => void;\n  updateLead: (id: string, patch: Partial<Lead>) => void;\n  removeLead: (id: string) => void;\n  updateJob: (id: string, patch: Partial<Job>) => void;\n  addJob: (job: Job) => void;\n  addInvoice: (inv: Invoice) => void;\n  updateInvoice: (id: string, patch: Partial<Invoice>) => void;\n  addCustomer: (c: Customer) => void;\n  updateCustomer: (id: string, patch: Partial<Customer>) => void;\n  addContract: (c: Contract) => void;\n  updateContract: (id: string, patch: Partial<Contract>) => void;\n  addService: (s: Service) => void;\n  updateService: (id: string, patch: Partial<Service>) => void;\n  removeService: (id: string) => void;\n  addTestimonial: (t: Testimonial) => void;\n  updateTestimonial: (id: string, patch: Partial<Testimonial>) => void;\n  removeTestimonial: (id: string) => void;\n  updateMaterial: (id: string, patch: Partial<Material>) => void;\n  updateEquipment: (id: string, patch: Partial<Equipment>) => void;\n  resetAll: () => void;\n}\n\nconst StoreCtx = createContext<StoreApi | null>(null);\n\nexport function StoreProvider({ children }: { children: React.ReactNode }) {\n  const [db, setDb] = useState<Database>(load);\n  const hydrated = useRef(false);\n\n  // Hydrate from the API server on first mount, if configured.\n  useEffect(() => {\n    if (!API) {\n      hydrated.current = true;\n      return;\n    }\n    let cancelled = false;\n    (async () => {\n      try {\n        const res = await fetch(`${API}/api/db`);\n        const remote = await res.json();\n        if (!cancelled && remote && remote.settings) {\n          setDb(remote as Database);\n        } else if (!cancelled) {\n          // Server is empty — seed it with our current data.\n          fetch(`${API}/api/db`, {\n            method: \"PUT\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify(db),\n          }).catch(() => {});\n        }\n      } catch {\n        /* offline — fall back to localStorage copy already in state */\n      } finally {\n        hydrated.current = true;\n      }\n    })();\n    return () => {\n      cancelled = true;\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  // Pull the serverless lead inbox (/api/leads on Vercel) and merge any leads\n  // this browser hasn't seen — website estimate requests reach the dashboard\n  // from any device this way.\n  useEffect(() => {\n    (async () => {\n      try {\n        const res = await fetch(\"/api/leads\", { headers: { accept: \"application/json\" } });\n        if (!res.ok || !res.headers.get(\"content-type\")?.includes(\"json\")) return;\n        const remote = (await res.json()) as Partial<Lead>[];\n        if (!Array.isArray(remote) || remote.length === 0) return;\n        setDb((d) => {\n          const known = new Set(d.leads.map((l) => l.id));\n          const fresh: Lead[] = remote\n            .filter((l) => l && typeof l.id === \"string\" && !known.has(l.id))\n            .map((l) => ({\n              id: l.id!,\n              name: l.name ?? \"Unknown\",\n              phone: l.phone ?? \"\",\n              email: l.email ?? \"\",\n              address: l.address ?? \"\",\n              city: l.city ?? \"\",\n              serviceInterest: l.serviceInterest ?? \"General inquiry\",\n              message: l.message ?? \"\",\n              status: l.status ?? \"new\",\n              source: l.source ?? \"website\",\n              createdAt: l.createdAt ?? new Date().toISOString(),\n              estSqft: l.estSqft,\n              value: l.value,\n            }));\n          if (fresh.length === 0) return d;\n          return { ...d, leads: [...fresh, ...d.leads] };\n        });\n      } catch {\n        /* local dev or offline — dashboard still works from local data */\n      }\n    })();\n  }, []);\n\n  // Persist: always to localStorage; debounced to the API when configured.\n  useEffect(() => {\n    try {\n      localStorage.setItem(KEY, JSON.stringify(db));\n    } catch {\n      /* quota — ignore */\n    }\n    if (!API || !hydrated.current) return;\n    const t = setTimeout(() => {\n      fetch(`${API}/api/db`, {\n        method: \"PUT\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(db),\n      }).catch(() => {});\n    }, 500);\n    return () => clearTimeout(t);\n  }, [db]);\n\n  const api = useMemo<StoreApi>(() => {\n    const patchIn = <T extends { id: string }>(arr: T[], id: string, patch: Partial<T>): T[] =>\n      arr.map((x) => (x.id === id ? { ...x, ...patch } : x));\n\n    return {\n      db,\n      updateSettings: (patch) => setDb((d) => ({ ...d, settings: { ...d.settings, ...patch } })),\n\n      addLead: (lead) => setDb((d) => ({ ...d, leads: [lead, ...d.leads] })),\n      updateLead: (id, patch) => setDb((d) => ({ ...d, leads: patchIn(d.leads, id, patch) })),\n      removeLead: (id) => setDb((d) => ({ ...d, leads: d.leads.filter((l) => l.id !== id) })),\n\n      updateJob: (id, patch) => setDb((d) => ({ ...d, jobs: patchIn(d.jobs, id, patch) })),\n      addJob: (job) => setDb((d) => ({ ...d, jobs: [job, ...d.jobs] })),\n\n      addInvoice: (inv) => setDb((d) => ({ ...d, invoices: [inv, ...d.invoices] })),\n      updateInvoice: (id, patch) =>\n        setDb((d) => ({ ...d, invoices: patchIn(d.invoices, id, patch) })),\n\n      addCustomer: (c) => setDb((d) => ({ ...d, customers: [c, ...d.customers] })),\n      updateCustomer: (id, patch) =>\n        setDb((d) => ({ ...d, customers: patchIn(d.customers, id, patch) })),\n\n      addContract: (c) => setDb((d) => ({ ...d, contracts: [c, ...d.contracts] })),\n      updateContract: (id, patch) =>\n        setDb((d) => ({ ...d, contracts: patchIn(d.contracts, id, patch) })),\n\n      addService: (s) => setDb((d) => ({ ...d, services: [...d.services, s] })),\n      updateService: (id, patch) =>\n        setDb((d) => ({ ...d, services: patchIn(d.services, id, patch) })),\n      removeService: (id) =>\n        setDb((d) => ({ ...d, services: d.services.filter((s) => s.id !== id) })),\n\n      addTestimonial: (t) => setDb((d) => ({ ...d, testimonials: [...d.testimonials, t] })),\n      updateTestimonial: (id, patch) =>\n        setDb((d) => ({ ...d, testimonials: patchIn(d.testimonials, id, patch) })),\n      removeTestimonial: (id) =>\n        setDb((d) => ({ ...d, testimonials: d.testimonials.filter((t) => t.id !== id) })),\n\n      updateMaterial: (id, patch) =>\n        setDb((d) => ({ ...d, materials: patchIn(d.materials, id, patch) })),\n      updateEquipment: (id, patch) =>\n        setDb((d) => ({ ...d, equipment: patchIn(d.equipment, id, patch) })),\n\n      resetAll: () => setDb(structuredClone(seed)),\n    };\n  }, [db]);\n\n  return <StoreCtx.Provider value={api}>{children}</StoreCtx.Provider>;\n}\n\nexport function useStore() {\n  const ctx = useContext(StoreCtx);\n  if (!ctx) throw new Error(\"useStore must be used within StoreProvider\");\n  return ctx;\n}\n\n/* ---- lightweight auth (local, single-owner) ---- */\nexport function useAuth() {\n  const [authed, setAuthed] = useState<boolean>(() => {\n    try {\n      return sessionStorage.getItem(AUTH_KEY) === \"1\";\n    } catch {\n      return false;\n    }\n  });\n  const login = (password: string) => {\n    // Demo gate — any non-empty password unlocks Michael's console.\n    if (password.trim().length > 0) {\n      sessionStorage.setItem(AUTH_KEY, \"1\");\n      setAuthed(true);\n      return true;\n    }\n    return false;\n  };\n  const logout = () => {\n    sessionStorage.removeItem(AUTH_KEY);\n    setAuthed(false);\n  };\n  return { authed, login, logout };\n}","lineStart":1,"lineEnd":245,"totalLines":245,"truncated":false}},"title":"app\\src\\lib\\store.tsx","time":{"start":1785872417070,"end":1785872417112}},"id":"prt_fce4a7d82001BQ72WfL1dH5y1w","sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","messageID":"msg_fce4a4b1f001D0nD851Ro9FLTz"}}
