{"type":"tool_use","timestamp":1785872631178,"sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","part":{"type":"tool","tool":"read","callID":"read_13","state":{"status":"completed","input":{"filePath":"C:\\WORK\\mt-asphalt-wt-backend\\app\\src\\lib\\store.tsx"},"output":"<path>C:\\WORK\\mt-asphalt-wt-backend\\app\\src\\lib\\store.tsx</path>\n<type>file</type>\n<content>\n1: import React, { createContext, useContext, useEffect, useMemo, useRef, useState } from \"react\";\n2: import type {\n3:   Database,\n4:   Settings,\n5:   Lead,\n6:   Job,\n7:   Invoice,\n8:   Customer,\n9:   Service,\n10:   Testimonial,\n11:   Contract,\n12:   Material,\n13:   Equipment,\n14: } from \"./types\";\n15: import { seed } from \"./seed\";\n16: \n17: /* ============================================================\n18:    Store — the app's data tier.\n19:    Persists the whole database to localStorage and exposes a\n20:    small typed API (read + mutate). Shaped like a repository so\n21:    it can be swapped for the included Express/JSON server later\n22:    without touching component code.\n23:    ============================================================ */\n24: \n25: const KEY = \"mt-asphalt-db-v1\";\n26: const AUTH_KEY = \"mt-asphalt-auth-v1\";\n27: \n28: // Optional backend tier. When VITE_API_URL is set (e.g. http://localhost:8787),\n29: // the store hydrates from and syncs to the Node REST server; otherwise it runs\n30: // entirely on localStorage. Component code is identical either way.\n31: const API = (import.meta.env.VITE_API_URL as string | undefined)?.replace(/\\/$/, \"\");\n32: \n33: function load(): Database {\n34:   try {\n35:     const raw = localStorage.getItem(KEY);\n36:     if (raw) return JSON.parse(raw) as Database;\n37:   } catch {\n38:     /* ignore */\n39:   }\n40:   return structuredClone(seed);\n41: }\n42: \n43: interface StoreApi {\n44:   db: Database;\n45:   // settings\n46:   updateSettings: (patch: Partial<Settings>) => void;\n47:   // generic collection mutators\n48:   addLead: (lead: Lead) => void;\n49:   updateLead: (id: string, patch: Partial<Lead>) => void;\n50:   removeLead: (id: string) => void;\n51:   updateJob: (id: string, patch: Partial<Job>) => void;\n52:   addJob: (job: Job) => void;\n53:   addInvoice: (inv: Invoice) => void;\n54:   updateInvoice: (id: string, patch: Partial<Invoice>) => void;\n55:   addCustomer: (c: Customer) => void;\n56:   updateCustomer: (id: string, patch: Partial<Customer>) => void;\n57:   addContract: (c: Contract) => void;\n58:   updateContract: (id: string, patch: Partial<Contract>) => void;\n59:   addService: (s: Service) => void;\n60:   updateService: (id: string, patch: Partial<Service>) => void;\n61:   removeService: (id: string) => void;\n62:   addTestimonial: (t: Testimonial) => void;\n63:   updateTestimonial: (id: string, patch: Partial<Testimonial>) => void;\n64:   removeTestimonial: (id: string) => void;\n65:   updateMaterial: (id: string, patch: Partial<Material>) => void;\n66:   updateEquipment: (id: string, patch: Partial<Equipment>) => void;\n67:   resetAll: () => void;\n68: }\n69: \n70: const StoreCtx = createContext<StoreApi | null>(null);\n71: \n72: export function StoreProvider({ children }: { children: React.ReactNode }) {\n73:   const [db, setDb] = useState<Database>(load);\n74:   const hydrated = useRef(false);\n75: \n76:   // Hydrate from the backend on first mount.\n77:   // 1. If VITE_API_URL is set, prefer that REST server.\n78:   // 2. Otherwise try the built-in Vercel Blob endpoint (/api/data).\n79:   // 3. Always merge the serverless lead inbox (/api/leads) last so new website\n80:   //    estimate requests appear regardless of which backend is in use.\n81:   // If every fetch fails, the localStorage/seed copy already in state is used.\n82:   useEffect(() => {\n83:     let cancelled = false;\n84:     (async () => {\n85:       let nextDb = db;\n86:       try {\n87:         if (API) {\n88:           const res = await fetch(`${API}/api/db`);\n89:           const remote = await res.json();\n90:           if (remote && remote.settings) {\n91:             nextDb = remote as Database;\n92:           } else {\n93:             // Server is empty — seed it with our current data.\n94:             fetch(`${API}/api/db`, {\n95:               method: \"PUT\",\n96:               headers: { \"Content-Type\": \"application/json\" },\n97:               body: JSON.stringify(nextDb),\n98:             }).catch(() => {});\n99:           }\n100:         } else {\n101:           const res = await fetch(\"/api/data\", { headers: { accept: \"application/json\" } });\n102:           if (res.ok) {\n103:             const remote = await res.json();\n104:             if (remote && remote.settings) {\n105:               nextDb = remote as Database;\n106:             } else {\n107:               // Blob is empty — seed it with our current data.\n108:               fetch(\"/api/data\", {\n109:                 method: \"PUT\",\n110:                 headers: { \"Content-Type\": \"application/json\" },\n111:                 body: JSON.stringify(nextDb),\n112:               }).catch(() => {});\n113:             }\n114:           }\n115:         }\n116:       } catch {\n117:         /* offline or backend down — use localStorage copy already in state */\n118:       }\n119: \n120:       // Pull the serverless lead inbox and merge any leads this browser hasn't seen.\n121:       try {\n122:         const res = await fetch(\"/api/leads\", { headers: { accept: \"application/json\" } });\n123:         if (!res.ok || !res.headers.get(\"content-type\")?.includes(\"json\")) return;\n124:         const remote = (await res.json()) as Partial<Lead>[];\n125:         if (!Array.isArray(remote) || remote.length === 0) return;\n126:         const known = new Set(nextDb.leads.map((l) => l.id));\n127:         const fresh: Lead[] = remote\n128:           .filter((l) => l && typeof l.id === \"string\" && !known.has(l.id))\n129:           .map((l) => ({\n130:             id: l.id!,\n131:             name: l.name ?? \"Unknown\",\n132:             phone: l.phone ?? \"\",\n133:             email: l.email ?? \"\",\n134:             address: l.address ?? \"\",\n135:             city: l.city ?? \"\",\n136:             serviceInterest: l.serviceInterest ?? \"General inquiry\",\n137:             message: l.message ?? \"\",\n138:             status: l.status ?? \"new\",\n139:             source: l.source ?? \"website\",\n140:             createdAt: l.createdAt ?? new Date().toISOString(),\n141:             estSqft: l.estSqft,\n142:             value: l.value,\n143:           }));\n144:         if (fresh.length > 0) {\n145:           nextDb = { ...nextDb, leads: [...fresh, ...nextDb.leads] };\n146:         }\n147:       } catch {\n148:         /* local dev or offline — dashboard still works from local data */\n149:       }\n150: \n151:       if (!cancelled) setDb(nextDb);\n152:       hydrated.current = true;\n153:     })();\n154:     return () => {\n155:       cancelled = true;\n156:     };\n157:     // eslint-disable-next-line react-hooks/exhaustive-deps\n158:   }, []);\n159: \n160:   // Persist: always to localStorage immediately; debounced to the backend when available.\n161:   useEffect(() => {\n162:     try {\n163:       localStorage.setItem(KEY, JSON.stringify(db));\n164:     } catch {\n165:       /* quota — ignore */\n166:     }\n167:     if (!hydrated.current) return;\n168:     const url = API ? `${API}/api/db` : \"/api/data\";\n169:     const t = setTimeout(() => {\n170:       fetch(url, {\n171:         method: \"PUT\",\n172:         headers: { \"Content-Type\": \"application/json\" },\n173:         body: JSON.stringify(db),\n174:       }).catch(() => {});\n175:     }, 500);\n176:     return () => clearTimeout(t);\n177:   }, [db]);\n178: \n179:   const api = useMemo<StoreApi>(() => {\n180:     const patchIn = <T extends { id: string }>(arr: T[], id: string, patch: Partial<T>): T[] =>\n181:       arr.map((x) => (x.id === id ? { ...x, ...patch } : x));\n182: \n183:     return {\n184:       db,\n185:       updateSettings: (patch) => setDb((d) => ({ ...d, settings: { ...d.settings, ...patch } })),\n186: \n187:       addLead: (lead) => setDb((d) => ({ ...d, leads: [lead, ...d.leads] })),\n188:       updateLead: (id, patch) => setDb((d) => ({ ...d, leads: patchIn(d.leads, id, patch) })),\n189:       removeLead: (id) => setDb((d) => ({ ...d, leads: d.leads.filter((l) => l.id !== id) })),\n190: \n191:       updateJob: (id, patch) => setDb((d) => ({ ...d, jobs: patchIn(d.jobs, id, patch) })),\n192:       addJob: (job) => setDb((d) => ({ ...d, jobs: [job, ...d.jobs] })),\n193: \n194:       addInvoice: (inv) => setDb((d) => ({ ...d, invoices: [inv, ...d.invoices] })),\n195:       updateInvoice: (id, patch) =>\n196:         setDb((d) => ({ ...d, invoices: patchIn(d.invoices, id, patch) })),\n197: \n198:       addCustomer: (c) => setDb((d) => ({ ...d, customers: [c, ...d.customers] })),\n199:       updateCustomer: (id, patch) =>\n200:         setDb((d) => ({ ...d, customers: patchIn(d.customers, id, patch) })),\n201: \n202:       addContract: (c) => setDb((d) => ({ ...d, contracts: [c, ...d.contracts] })),\n203:       updateContract: (id, patch) =>\n204:         setDb((d) => ({ ...d, contracts: patchIn(d.contracts, id, patch) })),\n205: \n206:       addService: (s) => setDb((d) => ({ ...d, services: [...d.services, s] })),\n207:       updateService: (id, patch) =>\n208:         setDb((d) => ({ ...d, services: patchIn(d.services, id, patch) })),\n209:       removeService: (id) =>\n210:         setDb((d) => ({ ...d, services: d.services.filter((s) => s.id !== id) })),\n211: \n212:       addTestimonial: (t) => setDb((d) => ({ ...d, testimonials: [...d.testimonials, t] })),\n213:       updateTestimonial: (id, patch) =>\n214:         setDb((d) => ({ ...d, testimonials: patchIn(d.testimonials, id, patch) })),\n215:       removeTestimonial: (id) =>\n216:         setDb((d) => ({ ...d, testimonials: d.testimonials.filter((t) => t.id !== id) })),\n217: \n218:       updateMaterial: (id, patch) =>\n219:         setDb((d) => ({ ...d, materials: patchIn(d.materials, id, patch) })),\n220:       updateEquipment: (id, patch) =>\n221:         setDb((d) => ({ ...d, equipment: patchIn(d.equipment, id, patch) })),\n222: \n223:       resetAll: () => setDb(structuredClone(seed)),\n224:     };\n225:   }, [db]);\n226: \n227:   return <StoreCtx.Provider value={api}>{children}</StoreCtx.Provider>;\n228: }\n229: \n230: export function useStore() {\n231:   const ctx = useContext(StoreCtx);\n232:   if (!ctx) throw new Error(\"useStore must be used within StoreProvider\");\n233:   return ctx;\n234: }\n235: \n236: /* ---- lightweight auth (local, single-owner) ---- */\n237: export function useAuth() {\n238:   const [authed, setAuthed] = useState<boolean>(() => {\n239:     try {\n240:       return sessionStorage.getItem(AUTH_KEY) === \"1\";\n241:     } catch {\n242:       return false;\n243:     }\n244:   });\n245:   const login = (password: string) => {\n246:     // Demo gate — any non-empty password unlocks Michael's console.\n247:     if (password.trim().length > 0) {\n248:       sessionStorage.setItem(AUTH_KEY, \"1\");\n249:       setAuthed(true);\n250:       return true;\n251:     }\n252:     return false;\n253:   };\n254:   const logout = () => {\n255:     sessionStorage.removeItem(AUTH_KEY);\n256:     setAuthed(false);\n257:   };\n258:   return { authed, login, logout };\n259: }\n\n(End of file - total 259 lines)\n</content>","metadata":{"preview":"import React, { createContext, useContext, useEffect, useMemo, useRef, useState } from \"react\";\nimport type {\n  Database,\n  Settings,\n  Lead,\n  Job,\n  Invoice,\n  Customer,\n  Service,\n  Testimonial,\n  Contract,\n  Material,\n  Equipment,\n} from \"./types\";\nimport { seed } from \"./seed\";\n\n/* ============================================================\n   Store — the app's data tier.\n   Persists the whole database to localStorage and exposes a\n   small typed API (read + mutate). Shaped like a repository so","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\WORK\\mt-asphalt-wt-backend\\app\\src\\lib\\store.tsx","text":"import React, { createContext, useContext, useEffect, useMemo, useRef, useState } from \"react\";\nimport type {\n  Database,\n  Settings,\n  Lead,\n  Job,\n  Invoice,\n  Customer,\n  Service,\n  Testimonial,\n  Contract,\n  Material,\n  Equipment,\n} from \"./types\";\nimport { seed } from \"./seed\";\n\n/* ============================================================\n   Store — the app's data tier.\n   Persists the whole database to localStorage and exposes a\n   small typed API (read + mutate). Shaped like a repository so\n   it can be swapped for the included Express/JSON server later\n   without touching component code.\n   ============================================================ */\n\nconst KEY = \"mt-asphalt-db-v1\";\nconst AUTH_KEY = \"mt-asphalt-auth-v1\";\n\n// Optional backend tier. When VITE_API_URL is set (e.g. http://localhost:8787),\n// the store hydrates from and syncs to the Node REST server; otherwise it runs\n// entirely on localStorage. Component code is identical either way.\nconst API = (import.meta.env.VITE_API_URL as string | undefined)?.replace(/\\/$/, \"\");\n\nfunction load(): Database {\n  try {\n    const raw = localStorage.getItem(KEY);\n    if (raw) return JSON.parse(raw) as Database;\n  } catch {\n    /* ignore */\n  }\n  return structuredClone(seed);\n}\n\ninterface StoreApi {\n  db: Database;\n  // settings\n  updateSettings: (patch: Partial<Settings>) => void;\n  // generic collection mutators\n  addLead: (lead: Lead) => void;\n  updateLead: (id: string, patch: Partial<Lead>) => void;\n  removeLead: (id: string) => void;\n  updateJob: (id: string, patch: Partial<Job>) => void;\n  addJob: (job: Job) => void;\n  addInvoice: (inv: Invoice) => void;\n  updateInvoice: (id: string, patch: Partial<Invoice>) => void;\n  addCustomer: (c: Customer) => void;\n  updateCustomer: (id: string, patch: Partial<Customer>) => void;\n  addContract: (c: Contract) => void;\n  updateContract: (id: string, patch: Partial<Contract>) => void;\n  addService: (s: Service) => void;\n  updateService: (id: string, patch: Partial<Service>) => void;\n  removeService: (id: string) => void;\n  addTestimonial: (t: Testimonial) => void;\n  updateTestimonial: (id: string, patch: Partial<Testimonial>) => void;\n  removeTestimonial: (id: string) => void;\n  updateMaterial: (id: string, patch: Partial<Material>) => void;\n  updateEquipment: (id: string, patch: Partial<Equipment>) => void;\n  resetAll: () => void;\n}\n\nconst StoreCtx = createContext<StoreApi | null>(null);\n\nexport function StoreProvider({ children }: { children: React.ReactNode }) {\n  const [db, setDb] = useState<Database>(load);\n  const hydrated = useRef(false);\n\n  // Hydrate from the backend on first mount.\n  // 1. If VITE_API_URL is set, prefer that REST server.\n  // 2. Otherwise try the built-in Vercel Blob endpoint (/api/data).\n  // 3. Always merge the serverless lead inbox (/api/leads) last so new website\n  //    estimate requests appear regardless of which backend is in use.\n  // If every fetch fails, the localStorage/seed copy already in state is used.\n  useEffect(() => {\n    let cancelled = false;\n    (async () => {\n      let nextDb = db;\n      try {\n        if (API) {\n          const res = await fetch(`${API}/api/db`);\n          const remote = await res.json();\n          if (remote && remote.settings) {\n            nextDb = remote as Database;\n          } else {\n            // Server is empty — seed it with our current data.\n            fetch(`${API}/api/db`, {\n              method: \"PUT\",\n              headers: { \"Content-Type\": \"application/json\" },\n              body: JSON.stringify(nextDb),\n            }).catch(() => {});\n          }\n        } else {\n          const res = await fetch(\"/api/data\", { headers: { accept: \"application/json\" } });\n          if (res.ok) {\n            const remote = await res.json();\n            if (remote && remote.settings) {\n              nextDb = remote as Database;\n            } else {\n              // Blob is empty — seed it with our current data.\n              fetch(\"/api/data\", {\n                method: \"PUT\",\n                headers: { \"Content-Type\": \"application/json\" },\n                body: JSON.stringify(nextDb),\n              }).catch(() => {});\n            }\n          }\n        }\n      } catch {\n        /* offline or backend down — use localStorage copy already in state */\n      }\n\n      // Pull the serverless lead inbox and merge any leads this browser hasn't seen.\n      try {\n        const res = await fetch(\"/api/leads\", { headers: { accept: \"application/json\" } });\n        if (!res.ok || !res.headers.get(\"content-type\")?.includes(\"json\")) return;\n        const remote = (await res.json()) as Partial<Lead>[];\n        if (!Array.isArray(remote) || remote.length === 0) return;\n        const known = new Set(nextDb.leads.map((l) => l.id));\n        const fresh: Lead[] = remote\n          .filter((l) => l && typeof l.id === \"string\" && !known.has(l.id))\n          .map((l) => ({\n            id: l.id!,\n            name: l.name ?? \"Unknown\",\n            phone: l.phone ?? \"\",\n            email: l.email ?? \"\",\n            address: l.address ?? \"\",\n            city: l.city ?? \"\",\n            serviceInterest: l.serviceInterest ?? \"General inquiry\",\n            message: l.message ?? \"\",\n            status: l.status ?? \"new\",\n            source: l.source ?? \"website\",\n            createdAt: l.createdAt ?? new Date().toISOString(),\n            estSqft: l.estSqft,\n            value: l.value,\n          }));\n        if (fresh.length > 0) {\n          nextDb = { ...nextDb, leads: [...fresh, ...nextDb.leads] };\n        }\n      } catch {\n        /* local dev or offline — dashboard still works from local data */\n      }\n\n      if (!cancelled) setDb(nextDb);\n      hydrated.current = true;\n    })();\n    return () => {\n      cancelled = true;\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  // Persist: always to localStorage immediately; debounced to the backend when available.\n  useEffect(() => {\n    try {\n      localStorage.setItem(KEY, JSON.stringify(db));\n    } catch {\n      /* quota — ignore */\n    }\n    if (!hydrated.current) return;\n    const url = API ? `${API}/api/db` : \"/api/data\";\n    const t = setTimeout(() => {\n      fetch(url, {\n        method: \"PUT\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(db),\n      }).catch(() => {});\n    }, 500);\n    return () => clearTimeout(t);\n  }, [db]);\n\n  const api = useMemo<StoreApi>(() => {\n    const patchIn = <T extends { id: string }>(arr: T[], id: string, patch: Partial<T>): T[] =>\n      arr.map((x) => (x.id === id ? { ...x, ...patch } : x));\n\n    return {\n      db,\n      updateSettings: (patch) => setDb((d) => ({ ...d, settings: { ...d.settings, ...patch } })),\n\n      addLead: (lead) => setDb((d) => ({ ...d, leads: [lead, ...d.leads] })),\n      updateLead: (id, patch) => setDb((d) => ({ ...d, leads: patchIn(d.leads, id, patch) })),\n      removeLead: (id) => setDb((d) => ({ ...d, leads: d.leads.filter((l) => l.id !== id) })),\n\n      updateJob: (id, patch) => setDb((d) => ({ ...d, jobs: patchIn(d.jobs, id, patch) })),\n      addJob: (job) => setDb((d) => ({ ...d, jobs: [job, ...d.jobs] })),\n\n      addInvoice: (inv) => setDb((d) => ({ ...d, invoices: [inv, ...d.invoices] })),\n      updateInvoice: (id, patch) =>\n        setDb((d) => ({ ...d, invoices: patchIn(d.invoices, id, patch) })),\n\n      addCustomer: (c) => setDb((d) => ({ ...d, customers: [c, ...d.customers] })),\n      updateCustomer: (id, patch) =>\n        setDb((d) => ({ ...d, customers: patchIn(d.customers, id, patch) })),\n\n      addContract: (c) => setDb((d) => ({ ...d, contracts: [c, ...d.contracts] })),\n      updateContract: (id, patch) =>\n        setDb((d) => ({ ...d, contracts: patchIn(d.contracts, id, patch) })),\n\n      addService: (s) => setDb((d) => ({ ...d, services: [...d.services, s] })),\n      updateService: (id, patch) =>\n        setDb((d) => ({ ...d, services: patchIn(d.services, id, patch) })),\n      removeService: (id) =>\n        setDb((d) => ({ ...d, services: d.services.filter((s) => s.id !== id) })),\n\n      addTestimonial: (t) => setDb((d) => ({ ...d, testimonials: [...d.testimonials, t] })),\n      updateTestimonial: (id, patch) =>\n        setDb((d) => ({ ...d, testimonials: patchIn(d.testimonials, id, patch) })),\n      removeTestimonial: (id) =>\n        setDb((d) => ({ ...d, testimonials: d.testimonials.filter((t) => t.id !== id) })),\n\n      updateMaterial: (id, patch) =>\n        setDb((d) => ({ ...d, materials: patchIn(d.materials, id, patch) })),\n      updateEquipment: (id, patch) =>\n        setDb((d) => ({ ...d, equipment: patchIn(d.equipment, id, patch) })),\n\n      resetAll: () => setDb(structuredClone(seed)),\n    };\n  }, [db]);\n\n  return <StoreCtx.Provider value={api}>{children}</StoreCtx.Provider>;\n}\n\nexport function useStore() {\n  const ctx = useContext(StoreCtx);\n  if (!ctx) throw new Error(\"useStore must be used within StoreProvider\");\n  return ctx;\n}\n\n/* ---- lightweight auth (local, single-owner) ---- */\nexport function useAuth() {\n  const [authed, setAuthed] = useState<boolean>(() => {\n    try {\n      return sessionStorage.getItem(AUTH_KEY) === \"1\";\n    } catch {\n      return false;\n    }\n  });\n  const login = (password: string) => {\n    // Demo gate — any non-empty password unlocks Michael's console.\n    if (password.trim().length > 0) {\n      sessionStorage.setItem(AUTH_KEY, \"1\");\n      setAuthed(true);\n      return true;\n    }\n    return false;\n  };\n  const logout = () => {\n    sessionStorage.removeItem(AUTH_KEY);\n    setAuthed(false);\n  };\n  return { authed, login, logout };\n}","lineStart":1,"lineEnd":259,"totalLines":259,"truncated":false}},"title":"app\\src\\lib\\store.tsx","time":{"start":1785872631170,"end":1785872631176}},"id":"prt_fce4dc3fa001rWUclQbdUMGB2P","sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","messageID":"msg_fce4db8510013Tu7uJp47YhGSo"}}
