0:   asphaltDensityLbPerCuFt?: number;\n51:   installLaborPerSqft?: number;\n52:   mobilizationFee?: number;\n53:   minJobCharge?: number;\n54:   sealcoatPerSqft?: number;\n55:   crackFillPerLinearFt?: number;\n56:   patchingPerSqft?: number;\n57:   millingPerSqft?: number;\n58:   basePrepPerSqft?: number;\n59:   stripingPerStall?: number;\n60:   markupPct?: number;\n61:   taxRatePct?: number;\n62:   depositPct?: number;\n63:   // brand\n64:   brandPrimary: string;\n65:   brandAccent: string;\n66:   brandSecondary: string;\n67: }\n68: \n69: export interface Service {\n70:   id: ID;\n71:   name: string;\n72:   slug: string;\n73:   icon: string; // lucide icon key\n74:   short: string;\n75:   description: string;\n76:   priceHint: string;\n77:   sortOrder: number;\n78:   active: boolean;\n79:   featured: boolean;\n80: }\n81: \n82: export interface Testimonial {\n83:   id: ID;\n84:   quote: string;\n85:   author: string;\n86:   location: string;\n87:   projectType: string;\n88:   rating: number;\n89:   active: boolean;\n90: }\n91: \n92: export type LeadStatus = \"new\" | \"contacted\" | \"quoted\" | \"won\" | \"lost\";\n93: export type LeadSource = \"website\" | \"phone\" | \"referral\" | \"google\" | \"yelp\" | \"repeat\";\n94: \n95: export interface Lead {\n96:   id: ID;\n97:   name: string;\n98:   phone: string;\n99:   email: string;\n100:   address: string;\n101:   city: string;\n102:   serviceInterest: string;\n103:   message: string;\n104:   estSqft?: number;\n105:   status: LeadStatus;\n106:   source: LeadSource;\n107:   createdAt: string;\n108:   value?: number; // estimated opportunity value\n109: }\n110: \n111: export interface Customer {\n112:   id: ID;\n113:   name: string;\n114:   type: \"residential\" | \"commercial\" | \"property_mgmt\" | \"hoa\" | \"municipal\";\n115:   phone: string;\n116:   email: string;\n117:   address: string;\n118:   city: string;\n119:   notes: string;\n120:   createdAt: string;\n121:   tags: string[];\n122: }\n123: \n124: export type JobStage =\n125:   | \"estimate\"\n126:   | \"scheduled\"\n127:   | \"in_progress\"\n128:   | \"completed\"\n129:   | \"invoiced\"\n130:   | \"paid\";\n131: \n132: export type JobPriority = \"low\" | \"normal\" | \"high\";\n133: \n134: export interface Job {\n135:   id: ID;\n136:   number: string; // JOB-2026-014\n137:   title: string;\n138:   customerId: ID;\n139:   customerName: string;\n140:   city: string;\n141:   address: string;\n142:   serviceTypes: string[];\n143:   stage: JobStage;\n144:   priority: JobPriority;\n145:   sqft: number;\n146:   value: number;\n147:   cost: number; // estimated internal cost\n148:   crewIds: ID[];\n149:   equipmentIds: ID[];\n150:   scheduledDate?: string;\n151:   completedDate?: string;\n152:   weatherSensitive: boolean;\n153:   progress: number; // 0-100\n154:   notes: string;\n155:   createdAt: string;\n156:   lat: number;\n157:   lng: number;\n158: }\n159: \n160: export type InvoiceStatus = \"draft\" | \"sent\" | \"paid\" | \"overdue\" | \"void\";\n161: \n162: export interface LineItem {\n163:   id: ID;\n164:   description: string;\n165:   qty: number;\n166:   unit: string;\n167:   rate: number;\n168: }\n169: \n170: export interface Invoice {\n171:   id: ID;\n172:   number: string; // INV-2026-031\n173:   jobId?: ID;\n174:   customerName: string;\n175:   customerAddress: string;\n176:   customerEmail: string;\n177:   jobSiteAddress: string;\n178:   lineItems: LineItem[];\n179:   taxRate: number;\n180:   notes: string;\n181:   paymentTerms: string;\n182:   status: InvoiceStatus;\n183:   issuedDate: string;\n184:   dueDate: string;\n185:   paidDate?: string;\n186: }\n187: \n188: export type ContractStatus = \"draft\" | \"sent\" | \"signed\" | \"active\" | \"complete\";\n189: \n190: export interface Contract {\n191:   id: ID;\n192:   number: string;\n193:   customerName: string;\n194:   customerAddress: string;\n195:   projectDescription: string;\n196:   scopeItems: string[];\n197:   totalAmount: number;\n198:   paymentSchedule: string;\n199:   warrantyText: string;\n200:   status: ContractStatus;\n201:   createdAt: string;\n202:   signedDate?: string;\n203: }\n204: \n205: export type CrewRole = \"foreman\" | \"operator\" | \"laborer\" | \"striping_tech\" | \"driver\";\n206: \n207: export interface CrewMember {\n208:   id: ID;\n209:   name: string;\n210:   role: CrewRole;\n211:   phone: string;\n212:   status: \"available\" | \"on_job\" | \"off\";\n213:   skills: string[];\n214:   hourlyCost: number;\n215:   initials: string;\n216: }\n217: \n218: export type EquipmentStatus = \"operational\" | \"in_use\" | \"maintenance\" | \"down\";\n219: export type EquipmentType =\n220:   | \"paver\"\n221:   | \"roller\"\n222:   | \"dump_truck\"\n223:   | \"sealcoat_rig\"\n224:   | \"striper\"\n225:   | \"skid_steer\"\n226:   | \"compactor\";\n227: \n228: export interface Equipment {\n229:   id: ID;\n230:   name: string;\n231:   type: EquipmentType;\n232:   status: EquipmentStatus;\n233:   hours: number; // engine hours\n234:   nextServiceHours: number;\n235:   lastService: string;\n236:   assignedJobId?: ID;\n237: }\n238: \n239: export interface Material {\n240:   id: ID;\n241:   name: string;\n242:   unit: string;\n243:   onHand: number;\n244:   reorderAt: number;\n245:   unitCost: number;\n246:   supplier: string;\n247: }\n248: \n249: export interface Activity {\n250:   id: ID;\n251:   ts: string;\n252:   kind: \"lead\" | \"job\" | \"invoice\" | \"payment\" | \"review\" | \"crew\" | \"system\";\n253:   text: string;\n254: }\n255: \n256: export interface RevenuePoint {\n257:   month: string; // \"Feb\"\n258:   revenue: number;\n259:   expenses: number;\n260:   jobs: number;\n261: }\n262: \n263: export interface Database {\n264:   settings: Settings;\n265:   services: Service[];\n266:   testimonials: Testimonial[];\n267:   leads: Lead[];\n268:   customers: Customer[];\n269:   jobs: Job[];\n270:   invoices: Invoice[];\n271:   contracts: Contract[];\n272:   crew: CrewMember[];\n273:   equipment: Equipment[];\n274:   materials: Material[];\n275:   activity: Activity[];\n276:   revenue: RevenuePoint[];\n277: }\n\n(End of file - total 277 lines)\n</content>","metadata":{"preview":"/* ============================================================\n   MT ASPHALT — Domain model\n   Shared types for the operations dashboard + public site.\n   ============================================================ */\n\nexport type ID = string;\n\nexport interface Settings {\n  companyName: string;\n  legalEntityName: string;\n  ownerName: string;\n  tagline: string;\n  phonePrimary: string;\n  phoneSecondary: string;\n  email: string;\n  addressLine1: string;\n  addressCity: string;\n  addressState: string;\n  addressZip: string;\n  mailingCity: string;","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\WORK\\mt-asphalt-wt-backend\\app\\src\\lib\\types.ts","text":"/* ============================================================\n   MT ASPHALT — Domain model\n   Shared types for the operations dashboard + public site.\n   ============================================================ */\n\nexport type ID = string;\n\nexport interface Settings {\n  companyName: string;\n  legalEntityName: string;\n  ownerName: string;\n  tagline: string;\n  phonePrimary: string;\n  phoneSecondary: string;\n  email: string;\n  addressLine1: string;\n  addressCity: string;\n  addressState: string;\n  addressZip: string;\n  mailingCity: string;\n  serviceCities: string[];\n  businessHours: string;\n  licenseNumber: string;\n  licenseClass: string;\n  licenseVerified: boolean;\n  licenseStatusNote: string;\n  showLicenseOnSite: boolean;\n  bondNumber: string;\n  bondCarrier: string;\n  bondAmount: number;\n  ratingAverage: number;\n  reviewCount: number;\n  yearsInBusiness: number;\n  foundedYear: number;\n  heroHeadline: string;\n  heroSubheadline: string;\n  ctaText: string;\n  aboutText: string;\n  googleBusinessUrl: string;\n  // financial defaults\n  laborRatePerHour: number;\n  salesTaxRate: number;\n  materialMarkupPct: number;\n  defaultPaymentTerms: string;\n  warrantyText: string;\n  /* Paving rate sheet — drives every calculated quote.\n     Optional so a database saved before these existed still loads;\n     see DEFAULT_RATES in lib/pricing.ts for the fallbacks. */\n  asphaltCostPerTon?: number;\n  asphaltDensityLbPerCuFt?: number;\n  installLaborPerSqft?: number;\n  mobilizationFee?: number;\n  minJobCharge?: number;\n  sealcoatPerSqft?: number;\n  crackFillPerLinearFt?: number;\n  patchingPerSqft?: number;\n  millingPerSqft?: number;\n  basePrepPerSqft?: number;\n  stripingPerStall?: number;\n  markupPct?: number;\n  taxRatePct?: number;\n  depositPct?: number;\n  // brand\n  brandPrimary: string;\n  brandAccent: string;\n  brandSecondary: string;\n}\n\nexport interface Service {\n  id: ID;\n  name: string;\n  slug: string;\n  icon: string; // lucide icon key\n  short: string;\n  description: string;\n  priceHint: string;\n  sortOrder: number;\n  active: boolean;\n  featured: boolean;\n}\n\nexport interface Testimonial {\n  id: ID;\n  quote: string;\n  author: string;\n  location: string;\n  projectType: string;\n  rating: number;\n  active: boolean;\n}\n\nexport type LeadStatus = \"new\" | \"contacted\" | \"quoted\" | \"won\" | \"lost\";\nexport type LeadSource = \"website\" | \"phone\" | \"referral\" | \"google\" | \"yelp\" | \"repeat\";\n\nexport interface Lead {\n  id: ID;\n  name: string;\n  phone: string;\n  email: string;\n  address: string;\n  city: string;\n  serviceInterest: string;\n  message: string;\n  estSqft?: number;\n  status: LeadStatus;\n  source: LeadSource;\n  createdAt: string;\n  value?: number; // estimated opportunity value\n}\n\nexport interface Customer {\n  id: ID;\n  name: string;\n  type: \"residential\" | \"commercial\" | \"property_mgmt\" | \"hoa\" | \"municipal\";\n  phone: string;\n  email: string;\n  address: string;\n  city: string;\n  notes: string;\n  createdAt: string;\n  tags: string[];\n}\n\nexport type JobStage =\n  | \"estimate\"\n  | \"scheduled\"\n  | \"in_progress\"\n  | \"completed\"\n  | \"invoiced\"\n  | \"paid\";\n\nexport type JobPriority = \"low\" | \"normal\" | \"high\";\n\nexport interface Job {\n  id: ID;\n  number: string; // JOB-2026-014\n  title: string;\n  customerId: ID;\n  customerName: string;\n  city: string;\n  address: string;\n  serviceTypes: string[];\n  stage: JobStage;\n  priority: JobPriority;\n  sqft: number;\n  value: number;\n  cost: number; // estimated internal cost\n  crewIds: ID[];\n  equipmentIds: ID[];\n  scheduledDate?: string;\n  completedDate?: string;\n  weatherSensitive: boolean;\n  progress: number; // 0-100\n  notes: string;\n  createdAt: string;\n  lat: number;\n  lng: number;\n}\n\nexport type InvoiceStatus = \"draft\" | \"sent\" | \"paid\" | \"overdue\" | \"void\";\n\nexport interface LineItem {\n  id: ID;\n  description: string;\n  qty: number;\n  unit: string;\n  rate: number;\n}\n\nexport interface Invoice {\n  id: ID;\n  number: string; // INV-2026-031\n  jobId?: ID;\n  customerName: string;\n  customerAddress: string;\n  customerEmail: string;\n  jobSiteAddress: string;\n  lineItems: LineItem[];\n  taxRate: number;\n  notes: string;\n  paymentTerms: string;\n  status: InvoiceStatus;\n  issuedDate: string;\n  dueDate: string;\n  paidDate?: string;\n}\n\nexport type ContractStatus = \"draft\" | \"sent\" | \"signed\" | \"active\" | \"complete\";\n\nexport interface Contract {\n  id: ID;\n  number: string;\n  customerName: string;\n  customerAddress: string;\n  projectDescription: string;\n  scopeItems: string[];\n  totalAmount: number;\n  paymentSchedule: string;\n  warrantyText: string;\n  status: ContractStatus;\n  createdAt: string;\n  signedDate?: string;\n}\n\nexport type CrewRole = \"foreman\" | \"operator\" | \"laborer\" | \"striping_tech\" | \"driver\";\n\nexport interface CrewMember {\n  id: ID;\n  name: string;\n  role: CrewRole;\n  phone: string;\n  status: \"available\" | \"on_job\" | \"off\";\n  skills: string[];\n  hourlyCost: number;\n  initials: string;\n}\n\nexport type EquipmentStatus = \"operational\" | \"in_use\" | \"maintenance\" | \"down\";\nexport type EquipmentType =\n  | \"paver\"\n  | \"roller\"\n  | \"dump_truck\"\n  | \"sealcoat_rig\"\n  | \"striper\"\n  | \"skid_steer\"\n  | \"compactor\";\n\nexport interface Equipment {\n  id: ID;\n  name: string;\n  type: EquipmentType;\n  status: EquipmentStatus;\n  hours: number; // engine hours\n  nextServiceHours: number;\n  lastService: string;\n  assignedJobId?: ID;\n}\n\nexport interface Material {\n  id: ID;\n  name: string;\n  unit: string;\n  onHand: number;\n  reorderAt: number;\n  unitCost: number;\n  supplier: string;\n}\n\nexport interface Activity {\n  id: ID;\n  ts: string;\n  kind: \"lead\" | \"job\" | \"invoice\" | \"payment\" | \"review\" | \"crew\" | \"system\";\n  text: string;\n}\n\nexport interface RevenuePoint {\n  month: string; // \"Feb\"\n  revenue: number;\n  expenses: number;\n  jobs: number;\n}\n\nexport interface Database {\n  settings: Settings;\n  services: Service[];\n  testimonials: Testimonial[];\n  leads: Lead[];\n  customers: Customer[];\n  jobs: Job[];\n  invoices: Invoice[];\n  contracts: Contract[];\n  crew: CrewMember[];\n  equipment: Equipment[];\n  materials: Material[];\n  activity: Activity[];\n  revenue: RevenuePoint[];\n}","lineStart":1,"lineEnd":277,"totalLines":277,"truncated":false}},"title":"app\\src\\lib\\types.ts","time":{"start":1785872417953,"end":1785872417979}},"id":"prt_fce4a8130001O7D2LQUFRfsDzK","sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","messageID":"msg_fce4a4b1f001D0nD851Ro9FLTz"}}
{"type":"tool_use","timestamp":1785872418037,"sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","part":{"type":"tool","tool":"read","callID":"read_4","state":{"status":"completed","input":{"filePath":"C:\\WORK\\mt-asphalt-wt-backend\\ASSISTANT_V1.md"},"output":"<path>C:\\WORK\\mt-asphalt-wt-backend\\ASSISTANT_V1.md</path>\n<type>file</type>\n<content>\n1: # Assistant V1 — what was added, and what's still blocking real use\n2: \n3: The dashboard now has an **Assistant** page. Michael talks or types, it asks at most\n4: five follow-up questions, prices the job from a rate sheet, and produces a draft\n5: contract or invoice for him to review.\n6: \n7: ---\n8: \n9: ## The conversation\n10: \n11: > **Michael:** \"hey give me a contract for Bob's parking lot, im doing a job for him\"\n12: \n13: From that one sentence the assistant already knows it's a **contract**, the service is\n14: **paving** (a parking lot), and the customer is **Bob** — matched against the customer\n15: list, so \"Bob\" finds \"Robert Maddox\". It does not know the size, so it asks. It never\n16: asks about anything Michael already said.\n17: \n18: > **Assistant:** \"Roughly how many square feet? A rough number is fine, or give me the\n19: > dimensions like 60 x 100.\"\n20: >\n21: > **Michael:** \"about 8500, three inch\"\n22: >\n23: > **Assistant:** \"What's the job site address?\"\n24: >\n25: > **Michael:** \"400 Mill Road\"\n26: >\n27: > **Assistant:** \"Done — I make it $33,416.48. Check the line items below before you send it.\"\n28: \n29: That total is 154.06 tons of hot mix at $125 ($19,257.81), installation labor at $1.10/sq ft\n30: ($9,350), mobilization ($450), plus 15% overhead and profit — every figure calculated in\n31: `pricing.ts`, none of it produced by the model. The 15% comes from the existing\n32: `materialMarkupPct` in Settings, which the rate sheet reuses rather than duplicating.\n33: \n34: Two questions, not five. The cap is a ceiling, not a quota — questions are ordered by\n35: price impact, so if it only gets a few answers it asked the ones that mattered.\n36: \n37: If it hits five questions with something still unknown, it drafts anyway and lists\n38: what's missing on the draft. It never silently invents a number.\n39: \n40: ---\n41: \n42: ## What was added\n43: \n44: ```\n45: app/api/chat.js                    serverless AI proxy — the key lives here, never in the browser\n46: app/src/lib/pricing.ts             tonnage + rate-sheet math, ported from the Python engine\n47: app/src/lib/assistant.ts           intent detection, slot extraction, question logic\n48: app/src/lib/speech.ts              Web Speech API wrapper\n49: app/src/lib/assistant.test.ts      71 verification checks\n50: app/src/admin/pages/Assistant.tsx  the page itself\n51: ```\n52: \n53: Modified: `App.tsx` (route), `nav.ts` (nav entry, fills the empty 5th slot in the mobile\n54: bottom bar), `types.ts` (optional rate fields on Settings), `tsconfig.json`,\n55: `package.json`, `.env.example`.\n56: \n57: Nothing existing was rewritten. The assistant writes into the same `Contract` and\n58: `Invoice` shapes the Contracts and Invoices pages already render, so drafts flow into\n59: the printable documents you already built.\n60: \n61: ---\n62: \n63: ## Setup\n64: \n65: ### The API key\n66: \n67: Set these in **Vercel → Project → Settings → Environment Variables**, or in\n68: `app/.env.local` for local dev:\n69: \n70: ```\n71: AI_API_KEY=sk-your-key-here\n72: AI_BASE_URL=https://api.deepseek.com\n73: AI_MODEL=deepseek-v4-flash\n74: ```\n75: \n76: **The missing `VITE_` prefix is deliberate.** Anything named `VITE_*` gets compiled into\n77: the browser bundle where every visitor can read it. These are read only by\n78: `api/chat.js`, server-side. The build is verified to contain no key, no provider URL,\n79: and no `AI_*` variable name.\n80: \n81: **Without a key everything still works.** The assistant falls back to a built-in\n82: scripted flow — same questions, same pricing, same drafts, plainer wording. The\n83: business never stops because an API is down.\n84: \n85: ### Provider choice\n86: \n87: Any OpenAI-compatible provider works; only the env vars change.\n88: \n89: | | |\n90: |---|---|\n91: | **DeepSeek direct** | `https://api.deepseek.com` · `deepseek-v4-flash` · ~$0.14/M in, $0.28/M out. A few dollars a month at Michael's volume. |\n92: | **OpenCode Go** | `https://opencode.ai/zen/v1` · `deepseek-v4-pro` · $10/mo, 16 models |\n93: \n94: Use OpenCode Go while developing. **For Michael's production use, get MT Asphalt its own\n95: DeepSeek key.** OpenCode Go's limits ($12 per 5 hours, $30 weekly, $60 monthly) are\n96: shared across your whole account — a heavy coding session on your side takes his\n97: contracts offline mid-job, and he'll have no idea why.\n98: \n99: ### Verify it\n100: \n101: ```\n102: cd app\n103: npm run verify     # 71 checks: pricing, extraction, question flow\n104: npm run build      # typecheck + production build\n105: ```\n106: \n107: `npm run verify` cross-checks the TypeScript pricing engine against the Python\n108: implementation it was ported from. Both produce **$44,542.85** on the same 8,500 sq ft\n109: job. If they ever diverge, one is wrong.\n110: \n111: ---\n112: \n113: ## Voice, and why it's built this way\n114: \n115: Speech uses the **browser's built-in Web Speech API**, not an audio-upload\n116: transcription service. Free, no second key, no upload delay, nothing recorded, and it\n117: works natively in Chrome on the S22 Ultra. The mic button hides itself on browsers that\n118: don't support it; typing always works.\n119: \n120: ## File uploads\n121: \n122: - **Text files** (`.txt` `.csv` `.md` `.json`) — contents are extracted and fed to the model as context. Works well.\n123: - **Photos** — attach to the record as reference. **The model cannot see them.** DeepSeek V4 Flash is text-only in the public API; image and document input are not supported. The UI says so plainly rather than pretending.\n124: - **PDFs** — attach but aren't parsed. Text extraction needs `pdfjs-dist` (~2 MB); worth adding only if Michael actually has PDFs he wants read.\n125: \n126: Measuring a lot from a photo is a much larger project and not what this is.\n127: \n128: ---\n129: \n130: ## Before Michael uses this for real work\n131: \n132: You said real use, not a demo. These four are genuine blockers.\n133: \n134: ### 1. The dashboard has no real password\n135: \n136: `useAuth` in `store.tsx` accepts **any non-empty string**. Your own `MICHAEL_GUIDE.md`\n137: flags this as a demo gate. If the Vercel deployment is public, anyone who finds\n138: `/dashboard` types one character and sees every customer, phone number, invoice, and\n139: revenue figure. Fix before real customer data goes in.\n140: \n141: ### 2. The rate sheet is invented\n142: \n143: Every number in `DEFAULT_RATES` is a plausible-looking placeholder, not MT Asphalt's\n144: costs. Placeholder rates producing confident-looking quotes is the most dangerous state\n145: this can be in, because it looks like it's working.\n146: \n147: Sit with Michael, get his real numbers, then enter 5–10 jobs he's **already quoted** and\n148: compare. Tune until the gap closes. That session is what makes him trust it — he watches\n149: it reproduce his own pricing on jobs he remembers.\n150: \n151: ### 3. The seeded data is fake\n152: \n153: `seed.ts` contains invented customers, jobs, and revenue. Robert Maddox and Harbor Plaza\n154: Retail are not real. If Michael starts working in the app without clearing them, he will\n155: eventually invoice a customer who doesn't exist or read revenue figures that were made\n156: up. Add a \"clear demo data\" action, or ship him a clean database.\n157: \n158: ### 4. localStorage is the only copy\n159: \n160: The whole business lives in one browser's localStorage. Clearing site data, a browser\n161: reset, or a new phone loses everything — no warning, no recovery. `store.tsx` already\n162: supports a backend via `VITE_API_URL`, and you already run Vercel Blob for leads. Turn\n163: one of those on before this holds real invoices.\n164: \n165: ### Also worth resolving\n166: \n167: **Sales tax.** Settings carries `salesTaxRate: 0.0775`, but the pricing engine defaults\n168: `taxRatePct` to 0 and shows a banner explaining why. California generally treats paving\n169: as an improvement to real property — the contractor pays tax on materials and does not\n170: charge the customer sales tax on the job. Getting this wrong in either direction is a\n171: real problem. It's a question for Michael's accountant, and the app surfaces it rather\n172: than guessing.\n173: \n174: ---\n175: \n176: ## Design rules worth keeping\n177: \n178: **The model never calculates money.** Every dollar comes from `pricing.ts`. The model\n179: extracts what Michael said and writes prose. An LLM doing arithmetic is fluent and\n180: occasionally, confidently wrong — and that wrong number goes out as a bill.\n181: \n182: **Two extractors, never overwriting.** Regex parsing and model parsing both run; local\n183: wins where they disagree. Michael typing `8500 sqft` always beats the model's\n184: interpretation of it. Disagreement only ever adds information.\n185: \n186: **Everything saves as `draft`.** The assistant never sets a contract to sent or an\n187: invoice to issued. Michael reviews on the existing pages and advances the status himself.\n188: \n189: ---\n190: \n191: ## Superseded\n192: \n193: The standalone Python/Flask app from the earlier session duplicated the Contracts and\n194: Invoices pages that already existed here — it was built without sight of this repo.\n195: Its pricing engine is the thing worth keeping and now lives in `app/src/lib/pricing.ts`.\n196: The rate-calibration workbook (`MT-Asphalt-Job-Intake.xlsx`) is still useful for the\n197: session with Michael; the rest can be dropped.\n\n(End of file - total 197 lines)\n</content>","metadata":{"preview":"# Assistant V1 — what was added, and what's still blocking real use\n\nThe dashboard now has an **Assistant** page. Michael talks or types, it asks at most\nfive follow-up questions, prices the job from a rate sheet, and produces a draft\ncontract or invoice for him to review.\n\n---\n\n## The conversation\n\n> **Michael:** \"hey give me a contract for Bob's parking lot, im doing a job for him\"\n\nFrom that one sentence the assistant already knows it's a **contract**, the service is\n**paving** (a parking lot), and the customer is **Bob** — matched against the customer\nlist, so \"Bob\" finds \"Robert Maddox\". It does not know the size, so it asks. It never\nasks about anything Michael already said.\n\n> **Assistant:** \"Roughly how many square feet? A rough number is fine, or give me the\n> dimensions like 60 x 100.\"\n>","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\WORK\\mt-asphalt-wt-backend\\ASSISTANT_V1.md","text":"# Assistant V1 — what was added, and what's still blocking real use\n\nThe dashboard now has an **Assistant** page. Michael talks or types, it asks at most\nfive follow-up questions, prices the job from a rate sheet, and produces a draft\ncontract or invoice for him to review.\n\n---\n\n## The conversation\n\n> **Michael:** \"hey give me a contract for Bob's parking lot, im doing a job for him\"\n\nFrom that one sentence the assistant already knows it's a **contract**, the service is\n**paving** (a parking lot), and the customer is **Bob** — matched against the customer\nlist, so \"Bob\" finds \"Robert Maddox\". It does not know the size, so it asks. It never\nasks about anything Michael already said.\n\n> **Assistant:** \"Roughly how many square feet? A rough number is fine, or give me the\n> dimensions like 60 x 100.\"\n>\n> **Michael:** \"about 8500, three inch\"\n>\n> **Assistant:** \"What's the job site address?\"\n>\n> **Michael:** \"400 Mill Road\"\n>\n> **Assistant:** \"Done — I make it $33,416.48. Check the line items below before you send it.\"\n\nThat total is 154.06 tons of hot mix at $125 ($19,257.81), installation labor at $1.10/sq ft\n($9,350), mobilization ($450), plus 15% overhead and profit — every figure calculated in\n`pricing.ts`, none of it produced by the model. The 15% comes from the existing\n`materialMarkupPct` in Settings, which the rate sheet reuses rather than duplicating.\n\nTwo questions, not five. The cap is a ceiling, not a quota — questions are ordered by\nprice impact, so if it only gets a few answers it asked the ones that mattered.\n\nIf it hits five questions with something still unknown, it drafts anyway and lists\nwhat's missing on the draft. It never silently invents a number.\n\n---\n\n## What was added\n\n```\napp/api/chat.js                    serverless AI proxy — the key lives here, never in the browser\napp/src/lib/pricing.ts             tonnage + rate-sheet math, ported from the Python engine\napp/src/lib/assistant.ts           intent detection, slot extraction, question logic\napp/src/lib/speech.ts              Web Speech API wrapper\napp/src/lib/assistant.test.ts      71 verification checks\napp/src/admin/pages/Assistant.tsx  the page itself\n```\n\nModified: `App.tsx` (route), `nav.ts` (nav entry, fills the empty 5th slot in the mobile\nbottom bar), `types.ts` (optional rate fields on Settings), `tsconfig.json`,\n`package.json`, `.env.example`.\n\nNothing existing was rewritten. The assistant writes into the same `Contract` and\n`Invoice` shapes the Contracts and Invoices pages already render, so drafts flow into\nthe printable documents you already built.\n\n---\n\n## Setup\n\n### The API key\n\nSet these in **Vercel → Project → Settings → Environment Variables**, or in\n`app/.env.local` for local dev:\n\n```\nAI_API_KEY=sk-your-key-here\nAI_BASE_URL=https://api.deepseek.com\nAI_MODEL=deepseek-v4-flash\n```\n\n**The missing `VITE_` prefix is deliberate.** Anything named `VITE_*` gets compiled into\nthe browser bundle where every visitor can read it. These are read only by\n`api/chat.js`, server-side. The build is verified to contain no key, no provider URL,\nand no `AI_*` variable name.\n\n**Without a key everything still works.** The assistant falls back to a built-in\nscripted flow — same questions, same pricing, same drafts, plainer wording. The\nbusiness never stops because an API is down.\n\n### Provider choice\n\nAny OpenAI-compatible provider works; only the env vars change.\n\n| | |\n|---|---|\n| **DeepSeek direct** | `https://api.deepseek.com` · `deepseek-v4-flash` · ~$0.14/M in, $0.28/M out. A few dollars a month at Michael's volume. |\n| **OpenCode Go** | `https://opencode.ai/zen/v1` · `deepseek-v4-pro` · $10/mo, 16 models |\n\nUse OpenCode Go while developing. **For Michael's production use, get MT Asphalt its own\nDeepSeek key.** OpenCode Go's limits ($12 per 5 hours, $30 weekly, $60 monthly) are\nshared across your whole account — a heavy coding session on your side takes his\ncontracts offline mid-job, and he'll have no idea why.\n\n### Verify it\n\n```\ncd app\nnpm run verify     # 71 checks: pricing, extraction, question flow\nnpm run build      # typecheck + production build\n```\n\n`npm run verify` cross-checks the TypeScript pricing engine against the Python\nimplementation it was ported from. Both produce **$44,542.85** on the same 8,500 sq ft\njob. If they ever diverge, one is wrong.\n\n---\n\n## Voice, and why it's built this way\n\nSpeech uses the **browser's built-in Web Speech API**, not an audio-upload\ntranscription service. Free, no second key, no upload delay, nothing recorded, and it\nworks natively in Chrome on the S22 Ultra. The mic button hides itself on browsers that\ndon't support it; typing always works.\n\n## File uploads\n\n- **Text files** (`.txt` `.csv` `.md` `.json`) — contents are extracted and fed to the model as context. Works well.\n- **Photos** — attach to the record as reference. **The model cannot see them.** DeepSeek V4 Flash is text-only in the public API; image and document input are not supported. The UI says so plainly rather than pretending.\n- **PDFs** — attach but aren't parsed. Text extraction needs `pdfjs-dist` (~2 MB); worth adding only if Michael actually has PDFs he wants read.\n\nMeasuring a lot from a photo is a much larger project and not what this is.\n\n---\n\n## Before Michael uses this for real work\n\nYou said real use, not a demo. These four are genuine blockers.\n\n### 1. The dashboard has no real password\n\n`useAuth` in `store.tsx` accepts **any non-empty string**. Your own `MICHAEL_GUIDE.md`\nflags this as a demo gate. If the Vercel deployment is public, anyone who finds\n`/dashboard` types one character and sees every customer, phone number, invoice, and\nrevenue figure. Fix before real customer data goes in.\n\n### 2. The rate sheet is invented\n\nEvery number in `DEFAULT_RATES` is a plausible-looking placeholder, not MT Asphalt's\ncosts. Placeholder rates producing confident-looking quotes is the most dangerous state\nthis can be in, because it looks like it's working.\n\nSit with Michael, get his real numbers, then enter 5–10 jobs he's **already quoted** and\ncompare. Tune until the gap closes. That session is what makes him trust it — he watches\nit reproduce his own pricing on jobs he remembers.\n\n### 3. The seeded data is fake\n\n`seed.ts` contains invented customers, jobs, and revenue. Robert Maddox and Harbor Plaza\nRetail are not real. If Michael starts working in the app without clearing them, he will\neventually invoice a customer who doesn't exist or read revenue figures that were made\nup. Add a \"clear demo data\" action, or ship him a clean database.\n\n### 4. localStorage is the only copy\n\nThe whole business lives in one browser's localStorage. Clearing site data, a browser\nreset, or a new phone loses everything — no warning, no recovery. `store.tsx` already\nsupports a backend via `VITE_API_URL`, and you already run Vercel Blob for leads. Turn\none of those on before this holds real invoices.\n\n### Also worth resolving\n\n**Sales tax.** Settings carries `salesTaxRate: 0.0775`, but the pricing engine defaults\n`taxRatePct` to 0 and shows a banner explaining why. California generally treats paving\nas an improvement to real property — the contractor pays tax on materials and does not\ncharge the customer sales tax on the job. Getting this wrong in either direction is a\nreal problem. It's a question for Michael's accountant, and the app surfaces it rather\nthan guessing.\n\n---\n\n## Design rules worth keeping\n\n**The model never calculates money.** Every dollar comes from `pricing.ts`. The model\nextracts what Michael said and writes prose. An LLM doing arithmetic is fluent and\noccasionally, confidently wrong — and that wrong number goes out as a bill.\n\n**Two extractors, never overwriting.** Regex parsing and model parsing both run; local\nwins where they disagree. Michael typing `8500 sqft` always beats the model's\ninterpretation of it. Disagreement only ever adds information.\n\n**Everything saves as `draft`.** The assistant never sets a contract to sent or an\ninvoice to issued. Michael reviews on the existing pages and advances the status himself.\n\n---\n\n## Superseded\n\nThe standalone Python/Flask app from the earlier session duplicated the Contracts and\nInvoices pages that already existed here — it was built without sight of this repo.\nIts pricing engine is the thing worth keeping and now lives in `app/src/lib/pricing.ts`.\nThe rate-calibration workbook (`MT-Asphalt-Job-Intake.xlsx`) is still useful for the\nsession with Michael; the rest can be dropped.","lineStart":1,"lineEnd":197,"totalLines":197,"truncated":false}},"title":"ASSISTANT_V1.md","time":{"start":1785872418020,"end":1785872418035}},"id":"prt_fce4a84a3001oI4fTQ2NADupw1","sessionID":"ses_031b5de68ffeW3IiUAK0XKmmr9","messageID":"msg_fce4a4b1f001D0nD851Ro9FLTz"}}
